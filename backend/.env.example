NODE_ENV=production
PORT=5000

# Production MySQL/MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=paradise1_hotel

# Generate a long random value. Never reuse the development secret.
JWT_SECRET=

# Public URLs
CLIENT_URL=https://YOUR-FRONTEND-DOMAIN
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN
API_PUBLIC_URL=https://YOUR-BACKEND-DOMAIN

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments / hotel account information
CURRENCY=ETB
CBE_ACCOUNT_NUMBER=
CBE_ACCOUNT_NAME=Paradise Hotel
CBE_BANK_NAME=Commercial Bank of Ethiopia
TELEBIRR_NUMBER=
TELEBIRR_NAME=Paradise Hotel
GOOGLE_CLIENT_ID=
